{
  "name": "chore-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env.local server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "start:win": "set NODE_ENV=production && node server/index.js",
    "db:init": "node --env-file=.env.local server/db/init.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "hash-wasm": "^4.11.0",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
